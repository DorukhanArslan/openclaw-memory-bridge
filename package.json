{
  "name": "openclaw-memory-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic developer lab backed by the pinned OpenClaw memory runtime",
  "scripts": {
    "lab": "node_modules/node/bin/node src/cli.ts",
    "start": "npm run lab -- shell",
    "demo": "npm run lab -- demo",
    "serve": "node_modules/node/bin/node src/stdio.ts",
    "test:protocol": "node_modules/node/bin/node --test tests/protocol.test.ts",
    "test:transport": "node_modules/node/bin/node --test tests/gateway.test.ts",
    "test:ready": "node_modules/node/bin/node --test tests/ready-gateway.test.ts",
    "test:config": "node_modules/node/bin/node --test tests/provider-handoff.test.ts",
    "test:budget": "node_modules/node/bin/node --test tests/budget-preflight.test.ts",
    "budget:preflight": "node_modules/node/bin/node examples/budget_preflight.ts",
    "smoke:bounded": "node_modules/node/bin/node examples/bounded_smoke.ts",
    "test:smoke": "node_modules/node/bin/node --test tests/paid-smoke.test.ts",
    "test": "node_modules/node/bin/node --test --test-concurrency=1 tests/*.test.ts",
    "test:vector": "node_modules/node/bin/node --test tests/vector.test.ts",
    "test:model": "node_modules/node/bin/node --test tests/model.test.ts",
    "test:dreaming": "node_modules/node/bin/node --test tests/dreaming.test.ts",
    "test:lifecycle": "node_modules/node/bin/node --test tests/lifecycle.test.ts",
    "test:flush": "node_modules/node/bin/node --test tests/flush.test.ts",
    "typecheck": "node_modules/node/bin/node node_modules/typescript/bin/tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "node": "24.16.0",
    "openclaw": "2026.9.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
